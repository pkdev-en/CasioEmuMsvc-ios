<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>CasioEmuMsvc</string>
    <key>CFBundleIdentifier</key>
    <string>com.pkdevvn.casioemu</string>
    <key>CFBundleExecutable</key>
    <string>CasioEmuMsvc</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIStatusBarHidden</key>
    <true/>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>

    <!-- Camera: needed by QR Code capture feature (QrCode.cpp / Gui/QrCodeWindow.cpp) -->
    <key>NSCameraUsageDescription</key>
    <string>CasioEmuMsvc needs camera access to scan QR codes displayed by the calculator for importing data.</string>

    <!-- Photo Library: needed for saving/exporting snapshots and QR captures to user's photos -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>CasioEmuMsvc needs photo library access to export calculator snapshots and QR code captures.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>CasioEmuMsvc needs to save calculator snapshots and QR captures to your photo library.</string>

    <!-- Network: Online Model Client fetches ROMs from the online server; Update Checker pings github -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>

    <!-- Icon: uses CFBundleIconFiles instead of xcassets -->
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array>
                <string>20.png</string>
                <string>29.png</string>
                <string>40.png</string>
                <string>58.png</string>
                <string>60.png</string>
                <string>80.png</string>
                <string>87.png</string>
                <string>120.png</string>
                <string>180.png</string>
                <string>1024.png</string>
            </array>
            <key>UIPrerenderedIcon</key>
            <false/>
        </dict>
    </dict>

    <!-- Hien thi thu muc app trong Files -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

