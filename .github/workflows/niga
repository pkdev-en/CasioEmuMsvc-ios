name: Xcode skibidi

on:
  workflow_dispatch:
  push:
    branches: ["stable", "master"]
    paths:
      - "CasioEmuMsvc/**"
      - "CMakeLists.txt"
      - ".github/workflows/niga.yml"

jobs:
  generate:
    runs-on: macos-latest
    name: CMake → Xcode project

    steps:
      - name: Checkout
        uses: actions/checkout@v6
        with:
          submodules: recursive

      - name: Configure — generate Xcode project
        run: |
          # Same CMake invocation as the full iOS build job, minus the
          # build/sign/package steps that come after it. This step alone
          # is what actually writes the .xcodeproj to disk.
          cmake -S . -B build -G Xcode -DCMAKE_SYSTEM_NAME=iOS -DCMAKE_OSX_DEPLOYMENT_TARGET=14.0 \
            -DCMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED=NO \
            -DCMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_REQUIRED=NO \
            -DCMAKE_XCODE_ATTRIBUTE_CODE_SIGN_IDENTITY="" \
            -DCMAKE_XCODE_ATTRIBUTE_DEVELOPMENT_TEAM="4Z7V3V3G9R" \
            -DCMAKE_CXX_STANDARD=20 \
            -DSDL_TESTS=OFF \
            -DSDL_DISABLE_INSTALL=ON \
            -DSDL2IMAGE_TESTS=OFF \
            -DSDL2IMAGE_INSTALL=OFF

      - name: Verify project was written
        run: |
          PROJ=$(find build -maxdepth 1 -name "*.xcodeproj")
          if [ -z "$PROJ" ]; then
            echo "No .xcodeproj found in build/ — CMake configure step failed silently."
            exit 1
          fi
          echo "Generated: $PROJ"

      - name: Zip the build directory
        run: |
          # Zip the whole build/ dir, not just the .xcodeproj — the project
          # references CMakeCache.txt / CMakeFiles/ that live alongside it,
          # so someone who clones the repo and drops this in can open the
          # .xcodeproj straight away without re-running cmake themselves.
          zip -r CasioEmuMsvc.xcodeproj.zip build

      - name: Upload .xcodeproj artifact
        uses: actions/upload-artifact@v4
        with:
          name: CasioEmuMsvc-xcodeproj
          path: CasioEmuMsvc.xcodeproj.zip
          retention-days: 14

      - name: Dump CMake error on failure
        if: failure()
        shell: bash
        run: |
          find . -name "CMakeError.log" -exec cat {} \;
          find . -name "CMakeOutput.log" -exec cat {} \;
